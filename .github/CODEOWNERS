/.github/zizmor.yml             @hegemony-sh/maintainers
/.github/CODEOWNERS             @hegemony-sh/maintainers
/.releaserc.json                @hegemony-sh/maintainers
/scripts/                       @hegemony-sh/maintainers
/.gitleaks.toml                 @hegemony-sh/maintainers
/SECURITY.md                    @hegemony-sh/maintainers
